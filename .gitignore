# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# e2e run output — traces, failure screenshots and the HTML report.
# The snapshot baselines in e2e/snapshots/ ARE committed.
/e2e/.artifacts/
/e2e/.report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# founders hub persisted state (runtime data)
/.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
