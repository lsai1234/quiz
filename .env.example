# ── Data source ───────────────────────────────────────────────────────────────
# Controls whether the app reads MOCK data or LIVE Shopify data.
#   auto    → use Shopify when credentials below are set, otherwise mock (default)
#   mock    → always use mock data, even when credentials are present
#   shopify → use Shopify; falls back to mock if credentials are missing
# Use NEXT_PUBLIC_DATA_SOURCE so the browser resolves the same as the server.
# (The portal will later let you flip this at runtime without redeploying.)
NEXT_PUBLIC_DATA_SOURCE=auto

# ── Shopify Storefront API (optional — leave blank to stay in mock mode) ────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10

# ── Shopify Admin API (only used by scripts/seed-shopify-tags.mjs) ──────────────
SHOPIFY_ADMIN_TOKEN=

# ── OpenAI (optional — enables live AI recommendation/identity) ─────────────────
OPENAI_API_KEY=
