# ── Data source ───────────────────────────────────────────────────────────────
# Controls whether the app reads MOCK data or LIVE Shopify data.
#   mock    → always use mock data, even when credentials are present (DEFAULT)
#   shopify → use Shopify; falls back to mock if credentials are missing
#   auto    → use Shopify when the credentials below are set, otherwise mock
# Mock is the default for now so subscriptions/pricing work without seeding
# Shopify. To go live, set this to `shopify` (or `auto`) AND seed the chrgd.*
# metafields first: `node scripts/seed-shopify-tags.mjs`.
# Use NEXT_PUBLIC_DATA_SOURCE so the browser resolves the same as the server.
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Shopify Storefront API (optional — leave blank to stay in mock mode) ────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10

# ── Shopify Admin API (seed script + portal live product writes) ────────────────
SHOPIFY_ADMIN_TOKEN=

# ── Founders Hub accounts (/portal login) ───────────────────────────────────────
# The Founders Hub uses per-founder email + password accounts. Configure up to 5
# (FOUNDER_1_* … FOUNDER_5_*). NAME is optional (defaults to the email's local part).
# When none are set, two demo founders work out of the box (dev only):
#   founder1@chrgd.dev / chrgd-founder-1   and   founder2@chrgd.dev / chrgd-founder-2
# Set real values in any shared/deployed environment.
FOUNDER_1_EMAIL=
FOUNDER_1_PASSWORD=
FOUNDER_1_NAME=
FOUNDER_2_EMAIL=
FOUNDER_2_PASSWORD=
FOUNDER_2_NAME=

# Legacy shared admin password. Optional — if set, it stays usable as an extra
# "admin@chrgd.dev" account. Prefer the FOUNDER_* accounts above.
ADMIN_PASSWORD=

# ── App database ─────────────────────────────────────────────────────────────────
# Backs accounts, sessions, subscriptions, feedback and portal edits.
#
# LOCAL (default): zero-config SQLite at `.data/chrgd.db` (created on demand,
# gitignored). Override the file location with DATABASE_PATH; tests use
# `:memory:`.
#
# SERVERLESS / PRODUCTION (Vercel etc.): SQLite does NOT persist on serverless
# — set DATABASE_URL to a hosted Postgres (Neon/Supabase/Vercel Postgres) and
# the app uses Postgres automatically. Vercel's Postgres integration injects
# POSTGRES_URL, which is also picked up. See docs/BACKEND.md.
DATABASE_PATH=
DATABASE_URL=

# ── Customer accounts (hub sign-in at /hub) ──────────────────────────────────────
# Email + password accounts work with no config. To also offer "Continue with
# Google", create an OAuth client (Web application) in Google Cloud console with
# redirect URI  <origin>/api/auth/google/callback  and set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin for OAuth redirects when deployed behind a proxy/custom domain
# (defaults to the request's origin, which is right for local dev).
APP_URL=

# ── OpenAI (optional — enables live AI recommendation/identity) ─────────────────
OPENAI_API_KEY=
