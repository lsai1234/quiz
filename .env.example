# ── Data source ───────────────────────────────────────────────────────────────
# Which catalogue the shop, quiz and hub serve.
#   mock → the built-in sample catalogue, plus anything added from PowerBody
#          (DEFAULT — every journey works without adding a single product)
#   real → ONLY the products you have added from the PowerBody feed. This is the
#          shop you actually sell. It starts EMPTY: add products in
#          Hub → Products → PowerBody and they appear here.
# There are no credentials involved — `real` reads products already imported and
# stored — so this cannot silently fall back, and there is no `auto` mode.
# A previous storefront integration was the old "live" side of this switch and
# has been removed; a stale `shopify` or `auto` value reads as `mock`, so an old
# deploy degrades quietly rather than breaking.
# Use NEXT_PUBLIC_DATA_SOURCE so the browser resolves the same as the server.
# The Founders Hub can override this at runtime (Settings → Data source).
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Supplier: PowerBody dropship (mock-first) ───────────────────────────────────
# READING: where the catalogue and live stock/prices come from.
#   mock      → built-in PowerBody sample feed (DEFAULT)
#   powerbody → use the PowerBody API; falls back to mock if credentials are missing
#   auto      → use PowerBody when the credentials below are set, otherwise mock
# The Founders Hub can override this at runtime (Settings → Supplier), which wins
# over this value. Server-only — the app reads the supplier via API routes.
SUPPLIER_SOURCE=mock

# PowerBody's SOAP endpoint and API user. All three are required: their API
# authenticates with login(username, apiKey), so the key alone opens nothing.
# These are secrets — put the real values in .env.local (git-ignored), never here.
POWERBODY_API_URL=https://www.powerbody.co.uk/api/soap/
POWERBODY_API_USER=
POWERBODY_API_KEY=

# Rate limiting. PowerBody answer HTTP 429 when asked too fast, and building the
# catalogue is the easiest way to trip it — getProductInfo is one call per
# product. The transport caps requests in flight and spaces them out; 429s are
# retried with backoff (honouring Retry-After). Their real limit isn't
# documented, so if you still see 429s: lower the concurrency, then raise the
# interval. Defaults below.
POWERBODY_MAX_CONCURRENT=2
POWERBODY_MIN_INTERVAL_MS=150

# Wall-clock budget for one catalogue load or SKU lookup, in ms. Browsing only
# reads the cheap list feed, so it should be quick; this is the backstop for when
# the supplier stops answering. One wire call can otherwise hang for over two
# minutes on its own (30s per attempt, retried), and a load that never answers
# leaves the Founders Hub sitting on "Loading the PowerBody feed…" with nothing
# to show. When this is spent, whatever has landed is returned.
# Must stay under the route's maxDuration (60s).
POWERBODY_BUILD_DEADLINE_MS=20000

# WRITING: whether pressing "Send" in the fulfilment queue really places an order.
#   simulate → walk the order through the flow, write the audit trail, send NOTHING (DEFAULT)
#   live     → place a real dropship order: stock committed, invoiced, parcel shipped
# Deliberately separate from SUPPLIER_SOURCE so the catalogue can run fully live —
# real products, real stock, kept up to date — while every order is still pretend.
# Live additionally requires SUPPLIER_SOURCE to resolve to powerbody; mock SKUs are
# sample data and must never be ordered for real. Overridable at runtime from the
# Founders Hub (Settings → Order sending). Anything other than exactly "live"
# simulates, so a typo can never arm real ordering.
SUPPLIER_ORDERING=simulate

# ── Payments: Stripe (mock-first) ───────────────────────────────────────────────
# Controls how the shop, quiz and subscriptions take payment.
#   mock   → checkout returns a placeholder, no charge (DEFAULT)
#   stripe → use Stripe; falls back to mock if the secret key is missing
#   auto   → use Stripe when STRIPE_SECRET_KEY is set, otherwise mock
# The Founders Hub can override this at runtime (Settings → Payments).
PAYMENTS_SOURCE=mock
STRIPE_SECRET_KEY=
# Publishable key is exposed to the browser for Stripe.js (NEXT_PUBLIC_*).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Verifies incoming webhooks at /api/webhooks/stripe (set once the endpoint exists).
STRIPE_WEBHOOK_SECRET=

# ── The demo plan in /myhub ────────────────────────────────────────────────────
# A hub sign-in with no stored subscription is handed the sample one, so the
# whole product is demoable with no credentials. That NEVER happens once
# payments resolve to Stripe — showing a customer a stack, a monthly price and
# delivery dates that were invented for them is not a demo, it is a lie about
# their account — and they get the "no plan yet" screen instead.
#
# Set to `off` to get that screen locally without needing live Stripe keys.
# There is deliberately no `on`: nothing switches fabricated data back on where
# the cards are real.
HUB_DEMO_SUBSCRIPTION=

# ── Founders Hub accounts (/founderhub login) ──────────────────────────────────
# The Founders Hub uses per-founder email + password accounts. Configure up to 5
# (FOUNDER_1_* … FOUNDER_5_*). NAME is optional (defaults to the email's local part).
# When none are set, two demo founders work out of the box IN DEVELOPMENT ONLY:
#   founder1@chrgd.dev / chrgd-founder-1   and   founder2@chrgd.dev / chrgd-founder-2
#
# REQUIRED IN PRODUCTION. Those demo credentials are printed on the sign-in
# screen, so a production build refuses them outright — an unconfigured hub lets
# nobody in rather than everybody. If /founderhub says "No founder accounts are
# configured", set at least FOUNDER_1_EMAIL + FOUNDER_1_PASSWORD here and
# REDEPLOY: new environment variables don't reach a deployment already running.
FOUNDER_1_EMAIL=
FOUNDER_1_PASSWORD=
FOUNDER_1_NAME=
FOUNDER_2_EMAIL=
FOUNDER_2_PASSWORD=
FOUNDER_2_NAME=

# Legacy shared admin password. Optional — if set, it stays usable as an extra
# "admin@chrgd.dev" account. Prefer the FOUNDER_* accounts above.
ADMIN_PASSWORD=

# ── App database ─────────────────────────────────────────────────────────────────
# Backs accounts, sessions, subscriptions, feedback and portal edits.
#
# LOCAL (default): zero-config SQLite at `.data/chrgd.db` (created on demand,
# gitignored). Override the file location with DATABASE_PATH; tests use
# `:memory:`.
#
# SERVERLESS / PRODUCTION (Vercel etc.): SQLite does NOT persist on serverless
# — set DATABASE_URL to a hosted Postgres (Neon/Supabase/Vercel Postgres) and
# the app uses Postgres automatically. Vercel's Postgres integration injects
# POSTGRES_URL, which is also picked up. See docs/BACKEND.md.
DATABASE_PATH=
DATABASE_URL=

# ── Customer accounts + social sign-in ──────────────────────────────────────────
# Email + password accounts work with no config. Each OAuth provider below is
# optional and only appears (on /myhub and at subscription checkout) once its
# credentials are set. Redirect URI for every provider is:
#     <origin>/api/auth/<provider>/callback      (provider = google|apple|facebook|twitter)
# Set APP_URL to your public origin when deployed behind a proxy/custom domain
# (defaults to the request's origin, right for local dev).
#
# APP_URL is the one that matters in production: Stripe checkout returns here,
# Stripe's billing portal returns here, OAuth redirects are built against it and
# every member email links into it. Set it to the apex domain, no trailing
# slash, https — get it wrong and paying customers land on the wrong host.
#     production → https://getchrgd.co.uk
APP_URL=

# The origin written into /sitemap.xml. Defaults to https://getchrgd.co.uk, so
# it only needs setting on preview deploys or a different domain.
NEXT_PUBLIC_SITE_URL=

# Google — Google Cloud console → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com app → Facebook Login. `email` permission
# needs Facebook app review before it works in production.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Microsoft — portal.azure.com → Entra ID → App registrations (free). Set the
# supported account types to "any Microsoft account" so Outlook/Hotmail sign in
# as well as work accounts. A work-tenant address is only trusted for linking to
# an existing account when the tenant proves the domain (`xms_edov` optional
# claim); personal accounts are always trusted.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Login with Amazon — developer.amazon.com → Login with Amazon → Security
# Profile (free). Web Settings holds the allowed return URL.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# Discord — discord.com/developers → New Application → OAuth2 (free, no review).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# LinkedIn — linkedin.com/developers app → Products → "Sign In with LinkedIn
# using OpenID Connect" (free; the product has to be added before the scopes work).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# GitHub — github.com/settings/developers → OAuth Apps (free, instant).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# X / Twitter — developer.x.com OAuth 2.0 client (Confidential, PKCE).
# NOTE: X does not return an email, so an X-only account can't be matched by
# email to a Google/Apple account and can't be recovered via email.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Sign in with Apple — needs a paid Apple Developer account and works only over
# HTTPS (your live domain, not localhost). CLIENT_ID is the Services ID; the
# private key is the .p8 file contents (newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── OpenAI (optional — enables live AI recommendation/identity) ─────────────────
OPENAI_API_KEY=

# ── Product changes (unavailability + supplier price moves) ────────────────────
# The daily job at /api/cron/daily detects supplier changes, applies what's due
# and sends the member emails it queued. Vercel Cron calls it on the schedule in
# vercel.json; the secret stops anyone else doing so — it changes what people
# are billed. Without CRON_SECRET the route is open in dev and CLOSED in
# production, so a missed env var fails safe.
CRON_SECRET=

# ── Member notifications ───────────────────────────────────────────────────────
# NOTIFY_SOURCE picks who does the sending:
#
#   manual (default) — no provider at all. Every email is written and listed in
#       Founders Hub → Emails for you to copy into your own mail client and tick
#       off. No API key, no domain verification.
#   gmail            — send through the Google Workspace account you already pay
#       for. No third-party service. 2,000 emails a day, which is far past what
#       this needs. See the GMAIL_* block below.
#   resend           — a dedicated email provider. Worth moving to when volume
#       grows or bounce handling starts to matter.
#   auto             — whichever provider is configured, sending everything.
#
# With `gmail` or `resend`, receipts send themselves and everything else gets a
# Send button and waits for you. See NOTIFY_AUTO_SEND.
NOTIFY_SOURCE=manual

# ── Sending through Google Workspace (no third-party service) ──────────────────
# Uses Gmail's HTTP API, not SMTP: Vercel blocks outbound port 25 and SMTP from a
# serverless function hangs until it times out rather than failing cleanly.
#
# To set this up: open Founders Hub → Emails and press "Connect Google
# Workspace". It walks the OAuth round trip and prints what to paste back here.
# The permission it asks for is `gmail.send` — it can send mail as the account
# and cannot read a single message in the mailbox.
#
# Client id/secret fall back to the GOOGLE_* pair the social login already uses;
# it is the same Google Cloud project, so there is no need for a second one.
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# The Workspace account being sent as, e.g. contact@getchrgd.co.uk.
GMAIL_SENDER=
# The addresses that account is allowed to send as, comma separated.
#
# Gmail only sends as the account itself or a VERIFIED send-as alias, and hands
# anything else back rewritten to the account address without complaining — so a
# mistyped alias looks like success and only shows up in a customer's inbox.
# Listing them here makes that fall back deliberately, with a warning in the log.
#
# Set the three noreply addresses up as aliases in Google Workspace Admin (free,
# no extra seat), add each in Gmail → Settings → Accounts → "Send mail as", then
# list them here. Or leave this blank and set NOTIFY_FROM to your own address to
# send everything from one place.
GMAIL_SEND_AS=
# Point the sender at a stub instead of Google — for verifying the whole path
# without emailing anybody. Leave blank.
GMAIL_TOKEN_URL=
GMAIL_API_URL=

RESEND_API_KEY=
# Override the Resend endpoint — for a self-hosted relay, or to point the Send
# button at a stub while testing. Leave blank for Resend itself.
RESEND_API_URL=
# Emails deep-link into /myhub, so these need to be absolute — set APP_URL
# above to your public origin or the links point at localhost.

# ── What sends by itself, and what waits for you ───────────────────────────────
#   confirmations (default once a provider exists) — order and subscription
#       receipts send the moment the payment lands. Everything else waits in the
#       hub for you to read and press Send.
#   all   — nothing waits.
#   none  — everything waits, even with a provider configured. The kill switch.
#
# The split is the point, not a compromise. A receipt has no judgement in it and
# is expected within seconds of paying, so a person in the loop can only make it
# late — and a confirmation that arrives the next morning reads as a shop that
# lost the order. Everything else says something we DECIDED (a product swapped, a
# price raised, a plan settled): occasionally wrong, worth reading before several
# hundred people do, and nobody is waiting on it by the second.
#
# Leave blank for the default. Nothing sends automatically without a provider,
# whatever this says — there would be nothing to send with.
#
# Password resets ignore this setting completely: they always send, because the
# member is locked out watching an inbox and there is no judgement in a reset
# link for anyone to review. With no provider at all they do not send, and the
# sign-in screens stop offering a reset rather than promising one.
NOTIFY_AUTO_SEND=

# ── Where member emails come FROM ─────────────────────────────────────────────
# Set NOTIFY_DOMAIN and each kind of email gets its own sending address:
#
#   orderconfirmation.noreply@<domain>  order receipts
#   subscriptions.noreply@<domain>      plan confirmations, changes, endings
#   billing.noreply@<domain>            payments, price changes, terms
#   account.noreply@<domain>            password resets and security notices
#
# Separate addresses because deliverability is measured per address: a price-rise
# notice that occasionally gets marked as spam should not drag the receipts down
# with it, and "all my getCHRGD orders" is a filter a customer can only write if
# orders arrive from their own address.
#
# BEFORE SETTING THIS: verify the domain in Resend and add the DNS records it
# gives you (SPF, DKIM and ideally DMARC) in Cloudflare. Sending from an
# unverified domain does not land in spam — it is rejected outright. Leave it
# blank until that is done and everything falls back to NOTIFY_FROM below.
NOTIFY_DOMAIN=
# Where a reply to one of those noreply addresses actually goes. A noreply
# sender with nowhere to reply to is how a customer with a question about their
# order ends up with nobody to ask — and mailbox providers treat it as a spam
# signal. Falls back to NEXT_PUBLIC_SUPPORT_EMAIL, then contact@NOTIFY_DOMAIN.
NOTIFY_REPLY_TO=contact@getchrgd.co.uk
# Override one stream's address without touching the others. Full header form,
# e.g. "getCHRGD Orders <receipts@getchrgd.co.uk>".
NOTIFY_FROM_ORDERS=
NOTIFY_FROM_SUBSCRIPTIONS=
NOTIFY_FROM_BILLING=
NOTIFY_FROM_ACCOUNT=
# Marketing: the stack people ask us to email them, welcomes, and campaigns.
# Its own address on purpose — it is the stream that collects the bounces and
# the spam reports, and keeping it away from the receipts means a bad campaign
# costs a campaign's reputation rather than a paying customer's confirmation.
NOTIFY_FROM_MARKETING=
# The older single address for everything, e.g. "CHRGD <hello@getchrgd.co.uk>".
# Still honoured, and used for every stream when NOTIFY_DOMAIN is blank.
NOTIFY_FROM=

# ── Email capture (the quiz's marketing list) ─────────────────────────────────
# The second capture point, on the "building your stack" screen. OFF unless set
# to `on`: it asks before the payoff, which is the shape that can cost
# conversion, so it exists to be measured against reveal-only rather than
# assumed. The reveal's own card is always on and needs no setting.
NEXT_PUBLIC_QUIZ_BUILD_CAPTURE=

# Bounces and spam complaints from Resend, so a dead mailbox or a complaint
# stops the marketing automatically. Copy the signing secret from the webhook
# you create in Resend (Webhooks → Add, pointing at
# https://your-domain/api/webhooks/resend, with email.bounced and
# email.complained). Unset means the endpoint refuses everything, which is the
# safe default: an open endpoint that can suppress addresses is a way to
# silence somebody else's customers.
RESEND_WEBHOOK_SECRET=

# ── Legal entity (shown in the terms + health disclaimer) ──────────────────────
# /legal/terms and /legal/disclaimer show a "not ready to publish" banner until
# all four are set. Fill them in — and have a solicitor review the copy — before
# taking real payments.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Where members post goods back when they cancel inside their statutory 14 days.
# Its own setting rather than a reuse of the registered address: a registered
# office is often an accountant's, and parcels arriving there is how a statutory
# return becomes a lost one. Falls back to NEXT_PUBLIC_REGISTERED_ADDRESS, so the
# return email always has somewhere to send people — set this before go-live.
# Comma-separated; it is split into address lines.
NEXT_PUBLIC_RETURNS_ADDRESS=
